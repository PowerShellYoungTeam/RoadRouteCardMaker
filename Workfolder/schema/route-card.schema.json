{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PowerShellYoungTeam/RoadRouteCardMaker/schema/route-card.schema.json",
  "title": "Road Movement Route Card",
  "type": "object",
  "required": ["schemaVersion", "instructions", "serials"],
  "properties": {
    "schemaVersion": { "enum": [1, 2], "description": "2 = current layout. Version 1 cards (old 1-17 instruction keys) are migrated on load." },
    "title": { "type": "string" },
    "instructions": {
      "type": "object",
      "description": "INSTRUCTIONS block items 1-16 (short-form field book wording). Defaults shown are applied to new cards.",
      "properties": {
        "movFrom": { "type": "string", "description": "1. Move From" },
        "movTo": { "type": "string", "description": "2. Move To" },
        "timeDateSp": { "type": "string", "description": "3. Time/Date at Start Point (free text, e.g. 0800 12/10/26)" },
        "sp": { "type": "string", "description": "4. Location of Start Point (grid ref). Blank = grid ref of the first serial From (b)." },
        "relPt": { "type": "string", "description": "5. Location of Release Point (grid ref of the last controlled point). Blank = grid ref of the last serial To (c)." },
        "averageSpeed": { "type": "string", "description": "6. Average speed (number in card units per hour, e.g. 40)" },
        "timeBetweenPackets": { "type": "string", "description": "7. Packet Intervals" },
        "vehDistDayMway": { "type": "string", "description": "8. Vehicle Distances - Day - M/Way (default 100 m)" },
        "vehDistDayARoads": { "type": "string", "description": "8. Vehicle Distances - Day - A Roads (default 50 m)" },
        "vehDistNightMway": { "type": "string", "description": "8. Vehicle Distances - Night - M/Way (default 50 m)" },
        "vehDistNightARoads": { "type": "string", "description": "8. Vehicle Distances - Night - A Roads (default 50 m)" },
        "halts": { "type": "string", "description": "9. Halts" },
        "lts": { "type": "string", "description": "10. Lights (default Dipped)" },
        "tfc": { "type": "string", "description": "11. Traffic (default Varying)" },
        "med": { "type": "string", "description": "12. Medical" },
        "rec": { "type": "string", "description": "13. Recovery" },
        "convoyFlagFront": { "type": "string", "description": "14. Convoy Flags - Front Vehicle (default Blue Flag)" },
        "convoyFlagRear": { "type": "string", "description": "14. Convoy Flags - Rear Vehicle (default Green Flag)" },
        "convoyFlagBreakdown": { "type": "string", "description": "14. Convoy Flags - Breakdown (default Yellow Flag)" },
        "contactTelSqnOps": { "type": "string", "description": "15. Contact Telephone - Sqn Ops" },
        "contactTelTpComd": { "type": "string", "description": "15. Contact Telephone - TP Comd" },
        "criticalPts": { "type": "string", "description": "16. Critical Points (multi-line)" }
      },
      "additionalProperties": { "type": "string" }
    },
    "vehicle": {
      "type": "object",
      "properties": {
        "heightM": { "type": ["number", "string"] },
        "widthM": { "type": ["number", "string"] },
        "lengthM": { "type": ["number", "string"] },
        "weightT": { "type": ["number", "string"] },
        "axleLoadT": { "type": ["number", "string"] },
        "hazmat": { "type": "boolean" }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "engine": { "enum": ["valhalla", "ors", "osrm"] },
        "engineUrls": { "type": "object", "additionalProperties": { "type": "string" } },
        "serialMode": { "enum": ["waypoint", "auto"] },
        "locationFormat": { "enum": ["latlon", "grid", "both"] },
        "units": { "enum": ["km", "mi"] },
        "timeSource": { "enum": ["speed", "router"] },
        "restrictionBufferMetres": { "type": "number" },
        "overpassUrl": { "type": "string" }
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lat", "lon"],
        "properties": { "lat": { "type": "number" }, "lon": { "type": "number" }, "name": { "type": "string" } }
      }
    },
    "serials": {
      "type": "array",
      "description": "ROUTE DETAILS table rows (a)-(h). Display strings are what is printed; raw numbers allow recalculation.",
      "items": {
        "type": "object",
        "required": ["ser"],
        "properties": {
          "ser": { "type": ["integer", "string"], "description": "(a)" },
          "from": { "type": "string", "description": "(b)" },
          "to": { "type": "string", "description": "(c)" },
          "route": { "type": "string", "description": "(d)" },
          "dir": { "type": "string", "description": "(e)" },
          "distance": { "type": "string", "description": "(f)" },
          "totalDistance": { "type": "string", "description": "(g)" },
          "totalTime": { "type": "string", "description": "(h)" },
          "distanceM": { "type": "number" },
          "durationS": { "type": "number" },
          "fromPoint": { "$ref": "#/$defs/point" },
          "toPoint": { "$ref": "#/$defs/point" },
          "fromCp": { "type": "string", "description": "Optional checkpoint name for the From point (GPX export only, not printed)" },
          "toCp": { "type": "string", "description": "Optional checkpoint name for the To point (GPX export only, not printed)" }
        }
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "kind": { "type": "string" },
          "value": { "type": "string" },
          "name": { "type": "string" },
          "conflict": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "attribution": { "type": "string" },
    "caveat": { "type": "string" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "properties": { "lat": { "type": "number" }, "lon": { "type": "number" }, "name": { "type": "string" } }
    }
  }
}
